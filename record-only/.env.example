APP_ENV=production
RELEASE_TAG=local
# Optional: use the three published GitHub Container Registry repositories.
# and RELEASE_TAG=sha-<full commit SHA> to deploy published images without building.
# API_IMAGE=ghcr.io/lmyzzzz/cyez-record-only-api
# DB_IMAGE=ghcr.io/lmyzzzz/cyez-record-only-postgres17
# GATEWAY_IMAGE=ghcr.io/lmyzzzz/cyez-record-only-https-gateway
DATA_PREFIX=cyez-library
BIND_IP=
HTTPS_PORT=443
TEACHER_USERNAME=
TEACHER_PASSWORD=
HASH_VERSION=
FIXED_SALT_HEX=
CARD_ISSUER=
UID_BYTE_LENGTHS=
PROVIDER_MODE=sqlserver
PROVIDER_MODULE=/adapters/provider.mjs
PROVIDER_CONFIG_KEY_FILE=/run/secrets/provider_config_key
PROVIDER_CONFIG_KEY_HOST_PATH=./secrets/provider-config-key
PROFILE_CONTRACT_CONFIRMED=false
# Module-mode adapters receive no built-in credential from Compose. If an
# adapter needs an operator-supplied secret, mount/provide it in a local
# override file; the api service does not read a provider_credential secret.
PROVIDER_TIMEOUT_MS=5000
PREVIEW_TTL_MS=120000
PREVIEW_LIMIT=10000
BATCH_LIMIT=500
SESSION_TTL_MS=3600000
CAPACITY_WARNING_BYTES=1073741824
CAPACITY_RESERVE_BYTES=268435456
CAPACITY_RECOVERY_BYTES=2147483648
CAPACITY_OLDEST_WARN_MS=3600000
# Optional: set to skip the one-shot init-volumes ownership job when the host or
# volume driver already provisions the expected UID/GID ownership.
# INIT_VOLUMES_MODE=skip
