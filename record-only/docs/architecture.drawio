        <mxCell id="ui-upstream" value="cyez-ui 已选定 · 上游 pnpm 工程&#10;@series/ui@0.1.0：. / theme / bootstrap / styles.css&#10;app.css / appearance-init.js；React 19 + router 7&#10;@series/electron@0.1.0：main / preload / shared&#10;Electron peer：&gt;=39 &lt;45；本项目固定实测兼容版本" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1100" width="800" height="225" as="geometry" />
        </mxCell>
        <mxCell id="vendor" value="受信任构建 → 固定 tarball → 本项目消费&#10;源提交 0a1d4f4… + 校验和 + LICENSE / NOTICE&#10;上游 pnpm 构建不改变本项目 Yarn 选择&#10;file: / 受控制品固定依赖；不依赖上游 node_modules&#10;干净安装、单份 React、preload 分包、打包运行验收" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="1100" width="800" height="225" as="geometry" />
        </mxCell>
        <mxCell id="ipc-boundary-title" value="Electron 权限边界 · cyez-ui 的窗口封装不授权业务 IPC" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="1440" width="1650" height="45" as="geometry" />
        </mxCell>
        <mxCell id="renderer-boundary" value="renderer + @series/ui&#10;sandbox / contextIsolation = true&#10;nodeIntegration = false&#10;无 raw UID / token / Node 系统权限" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="1515" width="490" height="140" as="geometry" />
        </mxCell>
        <mxCell id="preload-boundary" value="preload + @series/electron/preload&#10;有限 typed API / sender 校验&#10;刷卡元数据 / 业务动作 / 日志&#10;无任意 URL / shell / 原 UID / token" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="655" y="1515" width="490" height="140" as="geometry" />
        </mxCell>
        <mxCell id="main-boundary" value="main + @series/electron/main&#10;CardReader 立即算哈希 studentId&#10;原卡号仅临时 HTTPS；pin / OS 保存&#10;SQLite 仅持久提交意图与脱敏日志" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1515" width="490" height="140" as="geometry" />
        </mxCell>
        <mxCell id="release" value="已确认：cyez-ui 使用授权&#10;按固定提交 tarball 接入，保留 LICENSE/NOTICE&#10;TBD-06 仅 Windows 签名材料 / 发布实机验收&#10;上下两个一级入口：使用登记 / 设置&#10;不把上游验证当本项目集成通过" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1810" width="800" height="185" as="geometry" />
        </mxCell>
        <mxCell id="phase" value="范围与延期&#10;无学生端 / 完整 Session 状态机&#10;NEXT-01：换卡/盐改变 ID，历史关联迁移延期&#10;无 admin、机房 ACL、备份导出、历史编辑删除&#10;TBD-02：真实 API 拒绝语义待确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="1810" width="800" height="185" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="固定上游包已入 vendor；Yarn 4 工作区、教师应用与服务端已实现，真实外部接入按 TBD 验收。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
