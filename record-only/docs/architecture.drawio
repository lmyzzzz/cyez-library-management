        <mxCell id="title" value="04 · 业务事务、并发、幂等与批量结束" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="数据库是唯一权威；列表与 preview 都是快照。图中每列执行过程均服从底部统一锁顺序及条件唯一约束。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="entry" value="确认提交入口：验证账号 / client / 机房范围 / schema → 查 operations(actorId, requestId)&#10;已有同路由同摘要：返回原结果；同键异请求拒绝；preview / batchUnit 只成功消费一次&#10;新请求：验证预览绑定/TTL，开始事务并占用幂等键；先查结果再检查过期 preview" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="1680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="start-title" value="A · 开始使用" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="395" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="end-title" value="B · 单条结束" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="395" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="batch-title" value="C · 批量结束" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="395" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="start-0" value="目标明确&#10;previewId / deviceId / notes&#10;未知学生补充字段仅限白名单&#10;不从姓名班级猜测身份" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="545" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="start-1" value="锁定与验证&#10;设备可分配；学生未归档且无占用&#10;未知卡：同事务插入学生/凭证&#10;任一凭证别名冲突整笔回滚" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="start-2" value="写入&#10;创建 usage_record，结束时间为空&#10;写审计 + committed 操作结果&#10;条件唯一索引保证一人/一机一条" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1035" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="start-3" value="提交后返回&#10;返回记录 ID、版本与操作 ID&#10;竞争失败 409；无孤儿档案&#10;同键重试不重复创建" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1280" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="end-0" value="目标明确&#10;recordId + expectedVersion&#10;预览候选结束时间 / 完整备注值&#10;手动结束需显式确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="545" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="end-1" value="锁定与验证&#10;先读关联 ID，按统一顺序取锁&#10;重验关联、权限、版本、仍活动&#10;校验结束时间不早于开始" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="790" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="end-2" value="写入&#10;结束时间 / 原因 / 备注 / version++&#10;写审计 + committed 操作结果&#10;不重新按学生寻找另一条记录" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="1035" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="end-3" value="提交后返回&#10;同键重复：返回原结果&#10;其他键已结束/改版：409&#10;不静默覆盖刚编辑的备注" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="1280" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="batch-0" value="确认前已预览固定集合&#10;服务器解析有权机房与筛选范围&#10;保存 recordIds + versions + endedAtMs&#10;明确数量/机房，之后新增不纳入" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="545" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="batch-1" value="显式确认 → 单批事务&#10;按固定 ID 排序取锁并重验每条&#10;任一变更：整批 409 回滚&#10;过期/重启失效须重新预览" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="790" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="batch-2" value="写入与公共备注&#10;空备注：保留每条原文&#10;非空：原文 + 换行 + 批量结束备注&#10;同事务审计 / batchId / 操作结果" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1035" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="batch-3" value="单批全成或全败&#10;默认最多 500 条，可配置&#10;超过：固定分批计划 + 逐批状态&#10;跨批部分完成不能显示全局成功" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1280" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="locks" value="统一锁顺序：设备 IDs 升序 → 学生 IDs 升序 → 记录 IDs 升序&#10;开始、结束、归档、更正、批量都遵守；关联被改则回滚重预览，不临时反向加锁&#10;未知卡在设备锁后创建新学生；凭证/活动唯一冲突整笔回滚；死锁有限重试沿用原 requestId" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1555" width="1680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="recovery" value="提交结果未知 · 网络中断 / 应用重启&#10;main 先持久保存不含 UID 的提交意图&#10;GET /operations/{requestId} 查询结果&#10;未找到不证明没执行；重试仍用原键" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fcebea;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1775" width="800" height="165" as="geometry" />
        </mxCell>
        <mxCell id="batch-scope" value="范围和备注必须可解释&#10;“结束全部”= 账号授权范围全部活动记录&#10;“结束筛选结果”/“结束选中”使用不同按钮&#10;批量初始备注为空；追加由服务端执行一次" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1775" width="820" height="165" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="失败事务不会留下半个学生/使用记录；不允许 raw CRUD 绕过业务命令。归档、历史更正、作废均保留审计。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1978" width="1720" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
