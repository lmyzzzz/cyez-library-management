        <mxCell id="title" value="01 · 刷卡登记版总体架构" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="当前实施范围：教师 Electron + Docker 服务端；设备仅是登记资源。箭头表示调用或数据流，虚线表示日志归集。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="teacher-title" value="教师 Windows · 可有多个客户端" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="155" width="490" height="45" as="geometry" />
        </mxCell>
        <mxCell id="reader" value="独立读卡进程 · Rust mock / 硬件&#10;stdin/stdout JSON Lines v1 · 4 字节 UID&#10;Wiegand-34；TBD-03：真实硬件验收" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="225" width="450" height="120" as="geometry" />
        </mxCell>
        <mxCell id="renderer" value="React renderer + cyez-ui&#10;上：使用登记；下：设置&#10;设备编辑 / 只读历史 / 连接配置&#10;无原 UID、密码/token 或数据库权限" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="420" width="450" height="150" as="geometry" />
        </mxCell>
        <mxCell id="preload" value="受限 preload IPC&#10;sender + schema 校验，隔离 renderer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="640" width="450" height="95" as="geometry" />
        </mxCell>
        <mxCell id="main" value="Electron main · 启动读卡进程 / 立即哈希&#10;原卡号 + studentId 经已 pin HTTPS&#10;证书 pin / 共享认证 / 密码 OS 保存&#10;卡号不落盘；提交意图 / 日志可恢复" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="810" width="450" height="160" as="geometry" />
        </mxCell>
        <mxCell id="outbox" value="本地 SQLite 日志 outbox&#10;main / UI / reader / SDK / 安装日志&#10;稳定 logId，断网留盘&#10;服务端持久 ACK 后回收" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="1065" width="450" height="150" as="geometry" />
        </mxCell>
        <mxCell id="server-title" value="学校固定地址 · Linux Docker Compose" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="655" y="155" width="1090" height="45" as="geometry" />
        </mxCell>
        <mxCell id="api" value="HTTPS :443 → gateway → Fastify REST /api/v1&#10;共享登录 / 刷卡刷新 / 登记结束 / 设备编辑 / 历史 / 日志 ACK&#10;固定业务白名单；无 admin、机房 ACL 或运维数据查询" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="230" width="1040" height="115" as="geometry" />
        </mxCell>
        <mxCell id="services" value="Fastify + Sequelize · 服务端规则&#10;按原卡号重算 studentId，拒绝错配&#10;每次查 API；成功新增或覆盖缓存&#10;预览 TTL / 幂等 / 版本 / 事务" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="455" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="校园卡 API · 用本次原卡号查询&#10;正常 TLS；查询后释放原卡号&#10;TBD-02：协议、认证、卡号格式&#10;TBD-01：学生资料白名单" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="455" width="460" height="180" as="geometry" />
        </mxCell>
        <mxCell id="credentials" value="共享账号 · .env 修改后重建 API&#10;所有合法教师可分配全部设备&#10;clientId 只区分来源，不代表个人身份" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="725" width="480" height="125" as="geometry" />
        </mxCell>
        <mxCell id="previews" value="短期预览 · 有界内存&#10;绑定 clientId / 会话 / 学生版本&#10;默认 2 分钟；重启失效，须重刷" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="725" width="460" height="125" as="geometry" />
        </mxCell>
        <mxCell id="db" value="PostgreSQL · Sequelize 模型/事务/迁移，禁止手写 SQL&#10;students.id = 固定盐 SHA-256；设备 / 标签 / 使用记录&#10;无原卡号 / 独立 card_hash；历史只读 DB，不查校园 API&#10;操作结果 + 审计同事务，全部脱敏日志归集；占用条件唯一" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="955" width="1040" height="160" as="geometry" />
        </mxCell>
        <mxCell id="log-label" value="客户端日志也经 HTTPS API → 去重持久提交 → 逐项 ACK&#10;服务端 / gateway / DB 日志另经本地 spool → 内部 log-ingest" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="1150" width="1010" height="58" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="范围边界&#10;本版无学生端、人脸识别、锁机或屏幕墙&#10;“结束使用”仅结束记录，故障不控制或关闭电脑&#10;不限制设备总数；有限分页/批次用于资源保护" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1330" width="840" height="160" as="geometry" />
        </mxCell>
        <mxCell id="privacy" value="数据与刷新边界&#10;卡号临时请求 / 学生缓存分开；原卡号不入库或日志&#10;studentId 为哈希；API 为权威，本地仅缓存&#10;取消不撤销已刷新资料；日志仅用请求/记录 ID 关联" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1330" width="840" height="160" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="黄色：尚待外部确认的需求。蓝/绿：已决定的结构。本目录独立维护；实施与故障处理见 implementation-plan.md。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1588" width="1720" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
