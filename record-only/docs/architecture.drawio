        <mxCell id="title" value="05 · Docker 服务端部署与运维拓扑" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="目标是学校 Linux Docker Engine / Compose 单节点；Windows 宿主可使用 Linux VM。图中端口是设计约定，非已部署事实。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="client" value="教师 Electron · 设置连接&#10;IP / 端口 / SHA-256 叶证书指纹 / 共享账号密码&#10;应用内 pin 后才发 HTTPS，不改系统证书库" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="720" height="145" as="geometry" />
        </mxCell>
        <mxCell id="campus" value="校园卡 API · 本次原卡号查询，用后释放&#10;固定 HTTPS 目的地，正常 TLS，拒绝重定向&#10;TBD-02：协议、认证、原卡号格式与字段" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1020" y="155" width="720" height="145" as="geometry" />
        </mxCell>
        <mxCell id="host-title" value="Compose 项目 · frontend / backend 网络隔离 · 不发布 PostgreSQL 端口" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="430" width="1650" height="45" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="gateway · Nginx 非特权容器&#10;宿主 443 → 容器 8443&#10;TLS / body 上限 / 限速 / 日志脱敏&#10;刷卡 body 禁磁盘缓冲与缓存" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="530" width="430" height="165" as="geometry" />
        </mxCell>
        <mxCell id="api" value="api · Fastify / Sequelize&#10;内部 :3000 / 非 root / 单实例&#10;共享登录 + 业务 API 白名单&#10;无 admin、导出、服务器日志查询" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="530" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="db" value="db · PostgreSQL&#10;backend 内部 :5432&#10;pgdata 命名卷 / 独立角色&#10;不向 LAN 发布端口" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="530" width="430" height="165" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="部署 .env + 受限挂载&#10;TEACHER_USERNAME / PASSWORD&#10;改密需重建 API；旧 token 失效&#10;TLS / DB / provider 秘密不进镜像" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="800" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="spool" value="持久日志 spool · 多个来源卷&#10;API / gateway / DB / 运维日志&#10;数据库不可写继续留盘&#10;stdout 仅作额外运维输出" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="800" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="migrate" value="migrate · 单次串行任务&#10;Sequelize QueryInterface + Umzug&#10;版本迁移，不手写 SQL&#10;成功退出后 API 才启动" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="800" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ingest" value="log-ingest · 内部工作进程&#10;读 spool / 来源游标 / 去重&#10;提交 app_logs 后确认回收&#10;无公开端口、无 Docker socket" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="1090" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="容器基线&#10;只读根 FS / 有界 tmpfs / 可写日志卷&#10;cap_drop / no-new-privileges&#10;固定镜像版本与 digest，SIGTERM 排空" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="1090" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="seed" value="学生缓存 · API 权威&#10;成功刷卡新增或覆盖资料&#10;旧缓存仅供日常查询与历史&#10;没有教师注册、备份或导出服务" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1090" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="network-note" value="frontend：gateway 与 api；backend：api / db / migrate / log-ingest&#10;单宿主专用网络内部 HTTP；无关容器禁入；跨宿主/不可信网络改为 TLS。仅 gateway 发布端口。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="1310" width="1600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="build" value="镜像构建契约 · 多阶段&#10;固定 Node LTS / Yarn 4；install --immutable&#10;共享包 → server；focus 生产依赖含 Sequelize/pg&#10;复制 dist / 迁移 / 工作区产物，Linux 原生模块重建&#10;不含 Windows 依赖、UI 包、真实 .env 或个人数据" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1515" width="800" height="190" as="geometry" />
        </mxCell>
        <mxCell id="persist" value="数据与日志持久性&#10;pgdata / spool / 游标使用独立卷&#10;容器重建保留业务、审计、日志、操作结果&#10;不做备份/导出；有需由运维在产品外手工操作&#10;正常升级禁止 down -v；容量告警/限写/恢复" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1515" width="820" height="190" as="geometry" />
        </mxCell>
        <mxCell id="startup" value="启动：db healthy → ORM migrate 成功 → api ready → gateway 接入&#10;.env 改密后 force-recreate api，旧会话全部失效；教师用新密码重新登录&#10;live 测进程；ready 测 DB/schema；provider 故障停止刷卡，历史与手动结束仍可用" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1780" width="1680" height="145" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="TBD-04：Linux / 架构 / 服务器 IP / 含 IP SAN 的叶证书与可信指纹分发 / API 放通&#10;TBD-05：保留期及产品外清理；不新增教师备份、导出、机房授权或管理员页面&#10;单节点停机时禁止新业务；认证恢复后沿原 requestId 查询，日志留盘补传" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1990" width="1680" height="160" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="五类 Compose 服务：gateway / api / db / migrate / log-ingest；学生缓存由 API 在成功刷卡后维护。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2188" width="1720" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
