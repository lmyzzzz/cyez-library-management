        <mxCell id="filters" value="使用中  |  未使用     机房 ▼   标签 ▼   搜索   刷新     结束选中…   结束全部记录…" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="330" width="1320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="list" value="选择    设备 / 机房 / 标签     学生摘要     开始时间 / 时长     备注     操作&#10;□        A-001 / 图书馆       当前资料       10:20 / 18 分钟       查看     手动结束…&#10;□        A-002 / 图书馆       当前资料       10:25 / 13 分钟       编辑…    手动结束…&#10;使用中且禁用：仍显示占用，同时标注“已禁用，不可再次分配”&#10;未使用选项卡：空闲可分配与禁用明确区分，状态不只使用颜色" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="440" width="1320" height="230" as="geometry" />
        </mxCell>
        <mxCell id="list-status" value="已选条数 / 总条数 · 分页     |     断线保留过期视图，禁用业务写入，恢复后刷新" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="700" width="1320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="list-modal-note" value="刷卡门控：主页面 + 无 Modal + 无提交 + 无 scan 处理中；其余场景只 Toast，要求回主页面重新刷卡。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="865" width="1680" height="60" as="geometry" />
        </mxCell>
        <mxCell id="registration-title" value="B · 登记页 / 刷卡结束页" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="1025" width="490" height="45" as="geometry" />
        </mxCell>
        <mxCell id="summary" value="StudentSummary&#10;姓名 / 班级 / 校内学号：候选&#10;TBD-01：最终字段与必填项&#10;未知学生仅补充允许的字段" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="85" y="1100" width="470" height="150" as="geometry" />
        </mxCell>
        <mxCell id="times" value="时间与备注&#10;开始：本次刷卡时间，备注可空&#10;结束：原开始/本次结束，已有备注" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="85" y="1285" width="470" height="110" as="geometry" />
        </mxCell>
        <mxCell id="choice" value="登记：打开 DevicePicker →&#10;结束：固定设备 / recordId / version&#10;不自动替换成另一条新记录" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="85" y="1430" width="470" height="105" as="geometry" />
        </mxCell>
        <mxCell id="timer" value="取消   |   确认&#10;登记：5 秒后自动取消&#10;刷卡结束：5 秒后自动确认&#10;编辑/失焦暂停；回前台显式继续&#10;资料缺失/未选设备不可确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="85" y="1570" width="470" height="175" as="geometry" />
        </mxCell>
        <mxCell id="device-picker-title" value="C · DevicePicker · 可搜索分页" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="655" y="1025" width="490" height="45" as="geometry" />
        </mxCell>
        <mxCell id="picker-filter" value="机房 / 标签 / 搜索 / 状态筛选" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="665" y="1100" width="470" height="75" as="geometry" />
        </mxCell>
        <mxCell id="free" value="○ A-003 · 空闲 · 可选择&#10;显示设备名、机房、标签&#10;选择状态明确，键盘可操作" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="665" y="1220" width="470" height="105" as="geometry" />
        </mxCell>
        <mxCell id="busy" value="A-004 · 使用中 · 不可直接选&#10;[结束占用…] → 独立确认 Modal&#10;提交成功 → 刷新；释放晚于刷卡须重刷&#10;登记和结束是两个明确动作" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="665" y="1370" width="470" height="140" as="geometry" />
        </mxCell>
        <mxCell id="disabled" value="A-005 · 禁用 · 不可选&#10;显示原因，不与空闲混淆&#10;提交时服务端再次检查" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fcebea;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="665" y="1555" width="470" height="105" as="geometry" />
        </mxCell>
        <mxCell id="picker-hint" value="没有可分配设备 → 提示并禁用确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="665" y="1690" width="470" height="55" as="geometry" />
        </mxCell>
        <mxCell id="modal-title" value="D · 手动 / 批量结束 Modal" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1235" y="1025" width="490" height="45" as="geometry" />
        </mxCell>
        <mxCell id="single-modal" value="手动单结束&#10;复用结束页表单，加载已有备注&#10;固定记录版本；显式确认&#10;没有 5 秒自动提交" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="1100" width="470" height="140" as="geometry" />
        </mxCell>
        <mxCell id="batch-modal" value="批量结束 · 范围 / 条数 / 机房&#10;紧凑设备 + 学生 + 开始时间列表&#10;公共备注初始为空，只追加不覆盖&#10;后续新增不入固定集合&#10;取消   |   明确确认结束 N 条" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="1285" width="470" height="190" as="geometry" />
        </mxCell>
        <mxCell id="batch-status" value="冲突：整批回滚，重新预览确认&#10;超批次上限：显示逐批状态&#10;已成功批次不重复执行" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fcebea;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="1520" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="focus" value="焦点限制 / 关闭恢复 / 刷卡只 Toast" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="1680" width="470" height="65" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="其他管理页面&#10;记录：筛选、分页、导出；更正/作废需 admin + 原因&#10;学生 / 设备 / 标签：单条与批量预览、归档、版本冲突&#10;TBD-01：学生表单和 CSV 模板；TBD-05：权限与保留&#10;旧记录显示学生最新资料，不保存学生快照" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1870" width="800" height="220" as="geometry" />
        </mxCell>
        <mxCell id="diagnostics" value="诊断与界面安全&#10;服务器 / TLS / 版本 / reader 状态 / 待传日志数&#10;TBD-03：实际 reader 协议、驱动与型号&#10;不显示 UID / HMAC / token；不执行任意 shell&#10;Loading / 空态 / 错误 / 冲突 / 离线都提供清晰反馈" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1870" width="820" height="220" as="geometry" />
