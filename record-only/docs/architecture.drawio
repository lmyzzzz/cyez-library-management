        </mxCell>
        <mxCell id="subtitle" value="结构线框与交互规格；使用 cyez-ui 统一主题。左侧只有上下两个一级入口，设置内含连接、设备、历史和诊断。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
