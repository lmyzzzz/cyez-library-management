        <mxCell id="connect-title" value="设置 / 连接配置" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="770" width="770" height="45" as="geometry" />
        </mxCell>
        <mxCell id="connection-fields" value="服务端 IP   [                 ]    端口 [443]&#10;叶证书 SHA-256 指纹   [规范化的 64 位十六进制]&#10;账号 [          ]   密码 [••••••••]   □ 记住登录" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="840" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="connection-actions" value="测试连接    保存并登录    清除保存项&#10;pin 正确后才发送密码；不安装系统自签名证书&#10;密码由 main OS 加密；换配置清旧网络 session" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
