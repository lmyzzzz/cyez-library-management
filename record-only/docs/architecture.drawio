        <mxCell id="ui" value="ui · 项目适配包&#10;主题 / 路由 / 业务组件&#10;依赖 @series/ui&#10;不包含特权系统调用" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
