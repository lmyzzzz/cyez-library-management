        <mxCell id="register-title" value="使用登记 / 登记页" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="1910" width="500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="reg-info" value="学生摘要只读 · TBD-01 字段&#10;每次刷卡都向校园 API 查询&#10;成功时新增或覆盖缓存；无手动补填&#10;刷卡开始时间 / 备注 / DevicePicker&#10;失败不以旧缓存继续登记" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="1985" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="reg-timer" value="连续 10 秒无操作 → 自动取消&#10;键盘/指针/选择/编辑等真实操作重置&#10;轮询、动画、合成事件不重置&#10;后台继续计时，返回先清过期登记&#10;已提交则关闭空闲计时&#10;取消不撤销资料刷新或已发结束请求" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="2200" width="480" height="210" as="geometry" />
        </mxCell>
        <mxCell id="picker-panel-title" value="使用登记 / 设备选择" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="1910" width="500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="picker-body" value="空闲 → 可选；禁用 → 不可选&#10;占用 → 先独立确认结束，再刷新选择&#10;若释放晚于本次刷卡，要求重刷&#10;无可用设备 / 资料不齐 → 禁用确认&#10;提交仍由服务端重新校验" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="1985" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="picker-note" value="仅在设备列表收到刷卡才自动进入&#10;设置 / 历史 / Modal / 提交中只 Toast&#10;重复硬件帧不触发额外刷新&#10;新卡事件不替换正在处理的学生&#10;DevicePicker 内操作重置登记空闲&#10;不排队返回后自动重放刷卡" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="2200" width="480" height="210" as="geometry" />
        </mxCell>
        <mxCell id="end-panel-title" value="使用登记 / 结束与批量" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1235" y="1910" width="500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="end-card" value="刷卡结束仍为 5 秒自动确认&#10;现有备注、原开始、本次刷卡时间&#10;编辑 / 失焦 / 后台暂停自动提交&#10;返回显式继续；按钮/到期仅提交一次&#10;手动单结束 Modal：无自动确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="1985" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="batch-card" value="批量 Modal：固定列表 + 数量 + 范围&#10;公共备注初始为空，提交只追加一次&#10;结束全部 = 全系统活动记录&#10;单批冲突整体回滚；分批结果透明&#10;已结束历史不可修改或删除&#10;Modal 内刷卡仍只 Toast" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="2200" width="480" height="210" as="geometry" />
        </mxCell>
        <mxCell id="visual" value="cyez-ui 主题 / 间距 / 圆角 / 清晰字级；状态不只靠颜色，窄窗口筛选换行与表格横向滚动&#10;诊断只显示本机连接、读卡、版本与待传数量；无服务器系统日志、密钥、任意表或管理权限&#10;TBD-03 读卡硬件；TBD-05 保留期；TBD-06 Windows 发布材料；UI 使用授权已确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="2530" width="1700" height="115" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="本图是正式交互结构，不是已实现截图。所有请求经 pin 校验 HTTPS；历史页、设备页与手动结束不调用校园 API。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2688" width="1720" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
