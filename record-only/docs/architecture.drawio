        <mxCell id="title" value="07 · Yarn 工作区、cyez-ui 与 Electron 权限边界" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="上部为工作区组织与使用方→依赖；中部为上游→tarball 构建流；下部为本地 IPC。内部包使用 workspace:^。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="root" value="项目根 · 私有 monorepo · Yarn 4 精确版本 · 单一 yarn.lock · nodeLinker: node-modules&#10;workspaces 明确覆盖 record-only/apps/* + record-only/packages/*&#10;CI install --immutable；共享包 exports + 编译产物；禁止跨包相对导入与双份 DTO" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="1680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="server-app" value="record-only/apps/server · Node / Fastify&#10;依赖 protocol + domain；最终业务判断在服务端&#10;认证 / HMAC / preview / 占用事务 / provider / 日志&#10;不依赖 Electron / React / UI 包" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="800" height="170" as="geometry" />
        </mxCell>
        <mxCell id="teacher-app" value="record-only/apps/teacher · Electron / React&#10;依赖 protocol + client-sdk + ui&#10;renderer：页面；preload：受限桥；main：读卡/网络&#10;不导入服务端数据库或复制占用业务事务" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="390" width="800" height="170" as="geometry" />
        </mxCell>
        <mxCell id="packages-label" value="共享包&#10;workspace:^" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="685" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="domain" value="domain&#10;纯业务规则 / 时间 / 备注&#10;server 使用；无 I/O&#10;不混入后续三端 Session" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="85" y="755" width="385" height="170" as="geometry" />
        </mxCell>
        <mxCell id="protocol" value="protocol&#10;DTO / schema / 错误码&#10;毫秒整数 / 版本 / 幂等&#10;不含秘密或数据库连接" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="755" width="385" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sdk" value="client-sdk&#10;REST / 认证 / 查询恢复&#10;日志批传 / ACK / 重试&#10;依赖 protocol" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="915" y="755" width="385" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="ui · 项目适配包&#10;主题 / 路由 / 业务组件&#10;依赖 @series/ui&#10;不包含特权系统调用" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="755" width="385" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ui-upstream" value="cyez-ui 已选定 · 上游 pnpm 工程&#10;@series/ui@0.1.0：. / theme / bootstrap / styles.css&#10;app.css / appearance-init.js；React 19 + router 7&#10;@series/electron@0.1.0：main / preload / shared&#10;Electron peer：&gt;=39 &lt;45；本项目固定实测兼容版本" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1100" width="800" height="225" as="geometry" />
        </mxCell>
        <mxCell id="vendor" value="受信任构建 → 固定 tarball → 本项目消费&#10;源提交 0a1d4f4… + 校验和 + LICENSE / NOTICE&#10;上游 pnpm 构建不改变本项目 Yarn 选择&#10;file: / 受控制品固定依赖；不依赖上游 node_modules&#10;干净安装、单份 React、preload 分包、打包运行验收" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="1100" width="800" height="225" as="geometry" />
        </mxCell>
        <mxCell id="ipc-boundary-title" value="Electron 权限边界 · cyez-ui 的窗口封装不授权业务 IPC" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="1440" width="1650" height="45" as="geometry" />
        </mxCell>
        <mxCell id="renderer-boundary" value="renderer + @series/ui&#10;sandbox / contextIsolation = true&#10;nodeIntegration = false&#10;无 raw UID / token / Node 系统权限" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="1515" width="490" height="140" as="geometry" />
        </mxCell>
        <mxCell id="preload-boundary" value="preload + @series/electron/preload&#10;有限 typed API / sender 校验&#10;刷卡元数据 / 业务意图 / 日志&#10;不暴露任意 channel / URL / shell" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="655" y="1515" width="490" height="140" as="geometry" />
        </mxCell>
        <mxCell id="main-boundary" value="main + @series/electron/main&#10;系统安全存储 / REST / reader&#10;本地 SQLite 意图与日志&#10;provider 凭证只在服务端" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1515" width="490" height="140" as="geometry" />
        </mxCell>
        <mxCell id="release" value="TBD-06 · 发布输入&#10;库选择已确定；代码/二进制使用分发许可需留证&#10;上游 LICENSE/NOTICE 保留权利，未重新开源&#10;Windows 签名材料、安装/卸载与 DPI 实机验收&#10;本轮不复制上游源码，不声明已经集成通过" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1810" width="800" height="185" as="geometry" />
        </mxCell>
        <mxCell id="phase" value="范围和后续扩展&#10;本阶段不引入学生端 / Rust / 完整 Session 状态机&#10;NEXT-01：跨卡合并与历史迁移明确延期&#10;当前卡是唯一业务身份，内部 UUID 不等于跨卡识别&#10;后续共享包复用须审查业务语义是否相同" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="1810" width="800" height="185" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="上游提交与包入口已核对；应用目录和脚本为实施契约，当前文档仓库尚未创建运行中的工作区或应用。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2048" width="1720" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
