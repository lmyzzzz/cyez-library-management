        <mxCell id="title" value="05 · Docker 服务端部署与运维拓扑" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="目标是学校 Linux Docker Engine / Compose 单节点；Windows 宿主可使用 Linux VM。图中端口是设计约定，非已部署事实。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="client" value="教师 Windows Electron&#10;受信任校内证书 / client 身份 + 操作账号&#10;只访问固定服务器 HTTPS :443" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="720" height="145" as="geometry" />
        </mxCell>
        <mxCell id="campus" value="外部校园卡 API&#10;仅 api 受控出口可访问，凭证仅服务端持有&#10;TBD-02：主机 / 认证 / 限额 / 错误与 SLA" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1020" y="155" width="720" height="145" as="geometry" />
        </mxCell>
        <mxCell id="host-title" value="Compose 项目 · frontend / backend 网络隔离 · 不发布 PostgreSQL 端口" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="430" width="1650" height="45" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="gateway · Nginx 非特权容器&#10;宿主 443 → 容器 8443&#10;TLS / body 上限 / 限速&#10;覆写代理头 / 访问日志脱敏" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="530" width="430" height="165" as="geometry" />
        </mxCell>
        <mxCell id="api" value="api · Fastify 生产镜像&#10;仅内部 :3000 / 非 root&#10;业务 + 账号鉴权 + runtime schema&#10;运行账号仅必要数据库 DML" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="530" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="db" value="db · PostgreSQL&#10;backend 内部 :5432&#10;pgdata 命名卷 / 独立角色&#10;不向 LAN 发布端口" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="530" width="430" height="165" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="secrets · /run/secrets/*&#10;DB / HMAC / provider / TLS&#10;宿主文件挂载，不自带加密&#10;镜像/日志/源码中没有秘密" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="800" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="spool" value="持久日志 spool · 多个来源卷&#10;API / gateway / DB / 运维日志&#10;数据库不可写继续留盘&#10;stdout 仅作额外运维输出" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="800" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="migrate" value="migrate · 一次性任务&#10;与 API 同版镜像 / 独立 DDL 账号&#10;迁移锁 + 版本化 migration&#10;成功退出后 API 才启动" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="800" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ingest" value="log-ingest · 内部工作进程&#10;读 spool / 来源游标 / 去重&#10;提交 app_logs 后确认回收&#10;无公开端口、无 Docker socket" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="1090" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="容器基线&#10;只读根 FS / 有界 tmpfs / 可写日志卷&#10;cap_drop / no-new-privileges&#10;固定镜像版本与 digest，SIGTERM 排空" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="1090" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="backup" value="backup · 运维 profile / 调度&#10;独立凭证 / 匹配 PG 版本&#10;一致备份 + 必要 WAL/PITR&#10;加密发送校外或异盘目的地" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1090" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="network-note" value="frontend：gateway 与 api；backend：api / db / migrate / log-ingest / backup&#10;同宿主受控网络内部 HTTP；跨不可信网络改为 TLS。容器重启不能代替业务恢复和数据库迁移。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="1310" width="1600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="build" value="镜像构建契约 · 多阶段&#10;固定 Node LTS / Yarn 4；install --immutable&#10;共享包 → server 构建；workspaces focus 生产依赖&#10;复制 dist + 依赖工作区产物，Linux 原生模块重建&#10;不把 UI 包、Windows node_modules 或秘密放进镜像" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1515" width="800" height="190" as="geometry" />
        </mxCell>
        <mxCell id="persist" value="持久化与备份契约&#10;pgdata / 各来源 spool / 收集游标独立卷&#10;业务、审计、日志、操作结果都须可恢复&#10;备份包含加密密钥材料和未交接日志；恢复实测&#10;普通升级严禁 down -v；同盘副本不是灾备" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1515" width="820" height="190" as="geometry" />
        </mxCell>
        <mxCell id="startup" value="启动门禁：db healthy → migrate 成功 → api ready → gateway 接入&#10;/health/live：事件循环；/health/ready：DB、schema、必要写入条件；运行中仍处理 DB 断线&#10;迁移失败阻断；发布前备份，扩展—迁移—收缩；回旧镜像不等于撤销数据库迁移" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1780" width="1680" height="145" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="TBD-04：Linux 发行版 / 架构 / TLS 发放 / API 放通 / 备份位置 / RPO / RTO&#10;TBD-05：资料、记录、日志保留期和授权导出 / 归档规则&#10;单节点不承诺零停机；停机时禁止新业务，已发请求沿用 requestId，日志保留到恢复补传" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1990" width="1680" height="160" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="本轮交付部署设计，Dockerfile / Compose / migration 与容器测试在业务实现阶段落地；没有虚构可运行的应用镜像。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2188" width="1720" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
