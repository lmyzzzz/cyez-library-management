        </mxCell>
        <mxCell id="subtitle" value="当前实施范围：教师 Electron + Docker 服务端；设备仅是登记资源。箭头表示调用或数据流，虚线表示日志归集。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="teacher-title" value="教师 Windows · 可有多个客户端" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="155" width="490" height="45" as="geometry" />
        </mxCell>
        <mxCell id="reader" value="USB → CardReader 适配器&#10;scanId / 来源 / UID 字节&#10;TBD-03：协议、驱动、字节序" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="225" width="450" height="120" as="geometry" />
        </mxCell>
        <mxCell id="renderer" value="React renderer + cyez-ui&#10;设备列表 / 登记 / 结束 / 管理&#10;页面门控、确认、倒计时&#10;无原 UID、token 或数据库权限" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="420" width="450" height="150" as="geometry" />
        </mxCell>
        <mxCell id="preload" value="受限 preload IPC&#10;sender + schema 校验，隔离 renderer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="640" width="450" height="95" as="geometry" />
        </mxCell>
        <mxCell id="main" value="Electron main · TypeScript&#10;读卡防抖 / 认证 / REST SDK&#10;原 UID 仅短期内存 → 服务端&#10;持久提交意图 / 操作结果恢复" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="810" width="450" height="160" as="geometry" />
        </mxCell>
        <mxCell id="outbox" value="本地 SQLite 日志 outbox&#10;main / UI / reader / SDK / 安装日志&#10;稳定 logId，断网留盘&#10;服务端持久 ACK 后回收" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="1065" width="450" height="150" as="geometry" />
        </mxCell>
        <mxCell id="server-title" value="学校固定地址 · Linux Docker Compose" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="655" y="155" width="1090" height="45" as="geometry" />
        </mxCell>
        <mxCell id="api" value="HTTPS :443 → gateway → Fastify REST /api/v1&#10;注册 / 登录 / 预览 / 业务命令 / 查询 / 日志 ACK&#10;身份与机房权限、schema、限流；教师 IP 变化不影响主动请求" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="230" width="1040" height="115" as="geometry" />
        </mxCell>
        <mxCell id="services" value="业务模块 · 服务端最终判断&#10;学生与卡凭证 / 设备与标签&#10;开始 / 结束 / 批量固定集合&#10;预览 TTL / 幂等 / 版本 / 事务" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="455" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="外部校园卡 API · 服务端独占&#10;仅未知卡需要查询&#10;提取白名单后释放完整响应&#10;TBD-01 字段 / TBD-02 接口" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="455" width="460" height="180" as="geometry" />
        </mxCell>
        <mxCell id="credentials" value="身份与账号边界&#10;客户端身份：入网 / 日志 / 启动报告&#10;operator / admin：业务与机房授权" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="725" width="480" height="125" as="geometry" />
        </mxCell>
        <mxCell id="previews" value="短期候选 · 有界内存&#10;previewId 绑定账号 + 客户端&#10;默认 2 分钟；重启需重刷" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="725" width="460" height="125" as="geometry" />
        </mxCell>
        <mxCell id="db" value="PostgreSQL · 仅 Compose 内网 :5432 · pgdata 持久卷&#10;学生 / 卡 HMAC / 机房 / 设备 / 标签 / 使用记录&#10;操作结果 + 审计同事务；全部应用与部署日志统一存储&#10;活动记录条件唯一索引防止一人或一机重复占用" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="955" width="1040" height="160" as="geometry" />
        </mxCell>
        <mxCell id="log-label" value="客户端日志也经 HTTPS API → 去重持久提交 → 逐项 ACK&#10;服务端 / gateway / DB 日志另经本地 spool → 内部 log-ingest" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="1150" width="1010" height="58" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="范围边界&#10;本版无学生端、Rust、人脸识别、锁机或屏幕墙&#10;“结束使用”仅结束记录，故障不控制或关闭电脑&#10;不限制设备总数；有限分页/批次用于资源保护" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1330" width="840" height="160" as="geometry" />
        </mxCell>
        <mxCell id="privacy" value="统一规则&#10;业务失败不伪造成功；响应丢失用原 requestId 恢复&#10;所有已产生日志归集；无原卡号、token 或完整资料响应&#10;技术决策 / 来源 / 待定项详见 decisions.md" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1330" width="840" height="160" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="黄色：尚待外部确认的需求。蓝/绿：已决定的结构。后续三端扩展方案保留于根 docs/，不混用本版状态机。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1588" width="1720" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
