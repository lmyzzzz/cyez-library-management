          </mxGeometry>
        </mxCell>
        <mxCell id="end-tx" edge="1" parent="1" source="end-command" target="transaction" style="edgeStyle=none;rounded=0;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=0;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.7678571428571429;entryY=0.0;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1350" y="1510" as="sourcePoint" />
            <mxPoint x="1350" y="1615" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="title" value="03 · 刷卡、登记和结束的完整流程" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="实线为事件/请求/状态流；每次提交都重新校验权限、占用和版本。教师客户端显示成功必须以服务端提交结果为准。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="scan" value="① 读卡进程 → main 立即计算 studentId&#10;固定盐 SHA-256；原卡号独立短时内存&#10;卡号不经 renderer IPC、不进日志&#10;Wiegand-34 / 4 字节；TBD-03 实机验收" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="② 页面门控&#10;在设备列表主页面？&#10;无 Modal / 无提交 / 无 scan 处理中？&#10;全部满足才继续" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="155" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ignored" value="否 → 仅 Toast&#10;返回使用登记主页面重新刷卡&#10;丢弃事件，不调用外部 API&#10;不排队稍后重放" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fcebea;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="155" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="preview" value="③ main → 已 pin HTTPS /scan-previews&#10;card + studentId / hashVersion / scanId&#10;服务端重算 ID 拒绝错配，记 scanAtMs&#10;本地有无缓存都查询校园 API&#10;API 确认学生后才创建预览" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="395" width="500" height="155" as="geometry" />
        </mxCell>
        <mxCell id="gate-preview-label" value="是" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="730.0" y="327.0" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="本次原卡号查询校园 API&#10;查询/校验后释放；不入预览或队列&#10;TBD-02：协议/认证/拒绝语义/字段&#10;正常请求关联，无需额外绑定证明&#10;TBD-01：资料白名单；新增或覆盖缓存" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="395" width="500" height="155" as="geometry" />
        </mxCell>
        <mxCell id="failed-preview" value="API 拒绝 / 外部失败 / 卡号 ID 错配&#10;失败不写缓存，不以旧缓存放行&#10;显示错误，重刷或返回；无手动注册&#10;已有记录可从内部列表手动结束" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fcebea;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="395" width="500" height="155" as="geometry" />
        </mxCell>
        <mxCell id="mode" value="④ 学生缓存新增或覆盖单独提交&#10;按 studentId 返回 start/end，无原卡号&#10;历史只读 DB；取消不回滚缓存更新" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="640" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="register-form" value="无活动记录 → 登记页&#10;只读学生摘要、刷卡时间、备注和 DevicePicker&#10;连续 10 秒无任何用户操作自动取消&#10;键盘/指针/选择/编辑重置；后台返回先检查过期&#10;取消不占设备、不撤销资料刷新；无补填学生入口" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="865" width="780" height="185" as="geometry" />
        </mxCell>
        <mxCell id="end-form" value="有活动记录 → 刷卡结束页&#10;固定 recordId + expectedVersion&#10;当前资料、设备、原开始与本次刷卡时间&#10;备注预填已有值；默认 5 秒自动确认&#10;可立即确认或取消，不结束后来新开的记录" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="865" width="780" height="185" as="geometry" />
        </mxCell>
        <mxCell id="picker" value="选择设备 · 只能选可分配设备&#10;占用设备：先单独确认结束，服务端成功后刷新再选&#10;若释放晚于本次刷卡，须重刷以避免使用时间重叠&#10;禁用不可选；无设备/资料缺失不可提交；冲突重新确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1140" width="780" height="155" as="geometry" />
        </mxCell>
        <mxCell id="end-check" value="刷卡结束专用 5 秒确认规则&#10;编辑 / 失焦 / 后台 / 网络故障 → 暂停自动提交&#10;回到前台需显式继续或确认&#10;手动单结束 / 批量 Modal 没有自动确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="1140" width="780" height="155" as="geometry" />
        </mxCell>
        <mxCell id="start-command" value="POST /usage-records/start&#10;previewId + deviceId + notes + requestId&#10;仅创建使用记录，endedAtMs = null；学生必须已存在" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1385" width="780" height="125" as="geometry" />
        </mxCell>
        <mxCell id="end-command" value="POST /usage-records/{id}/end&#10;previewId + recordId + expectedVersion + notes + requestId&#10;endedAtMs 取本次 scanAtMs；提交时再验 end ≥ start" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="1385" width="780" height="125" as="geometry" />
        </mxCell>
        <mxCell id="transaction" value="⑤ 服务端事务 → 数据 + 审计 + 持久操作结果一起提交&#10;成功返回设备列表并刷新；409 冲突需重新确认，410 预览失效需重刷&#10;已发请求超时：保留同一 requestId 查询/重试，不把超时当失败另开新请求" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1615" width="1680" height="135" as="geometry" />
        </mxCell>
        <mxCell id="preview-rule" value="预览 / 幂等&#10;默认 2 分钟有界内存；取消释放，重启失效&#10;intentId 成功消费一次；同 clientId/requestId 可重试&#10;已提交结果不随预览失效，重新登录后仍可查询" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1825" width="800" height="165" as="geometry" />
        </mxCell>
        <mxCell id="time-rule" value="时间规则&#10;scanAtMs = 服务端接收刷卡请求的时刻&#10;createdAtMs / updatedAtMs = 实际提交时间&#10;JSON 为 Unix 毫秒整数；客户端时钟不定历史" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1825" width="820" height="165" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="登记空闲取消不撤销资料刷新或已发独立请求；刷卡结束自动确认失焦暂停。所有 UI 成功均以服务端结果为准。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2028" width="1720" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
