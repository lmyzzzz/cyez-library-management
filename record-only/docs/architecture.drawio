        <mxCell id="nav-hint" value="一级入口只有两个&#10;设置固定于侧栏下方&#10;其余页面在内容区内切换" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
