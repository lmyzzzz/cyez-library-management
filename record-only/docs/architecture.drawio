        <mxCell id="card-identity" edge="1" parent="1" source="card-hash" target="students" style="edgeStyle=none;rounded=0;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.4897959183673469;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="950" as="sourcePoint" />
            <mxPoint x="60" y="280" as="targetPoint" />
            <Array as="points">
              <mxPoint x="30" y="950" />
              <mxPoint x="30" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="title" value="02 · 数据模型、关系与一致性约束" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="实线从外键引用方指向被引用方，边旁写明基数；虚线为约束/算法说明。活动占用只从 usage_records 派生。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="students" value="students · API 资料缓存&#10;PK id = 固定盐 SHA-256 / STRING(64)&#10;hash_version / 最新白名单资料&#10;profile_refreshed_at / version&#10;无原卡号 / card_hash / lookupRef&#10;TBD-01：姓名、班级、校内学号" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="500" height="245" as="geometry" />
        </mxCell>
        <mxCell id="records" value="usage_records · 一次使用一条&#10;UUID PK id / UUID FK device_id&#10;FK student_id STRING(64) → students.id&#10;started_at / ended_at nullable&#10;notes / end_reason / version / clientId&#10;结束后只读；无原卡号" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="160" width="500" height="245" as="geometry" />
        </mxCell>
        <mxCell id="devices" value="devices · 设备资源&#10;PK id / unique code / display_name&#10;notes / version / is_disabled&#10;deleted_at 软删除，保留历史 FK&#10;无 room ACL；机房/分区用标签" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="160" width="500" height="245" as="geometry" />
        </mxCell>
        <mxCell id="student-many" value="N : 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="200" width="70" height="65" as="geometry" />
        </mxCell>
        <mxCell id="device-many" value="N : 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="200" width="70" height="65" as="geometry" />
        </mxCell>
        <mxCell id="card" value="校园 API 是权威数据源&#10;每次有效刷卡按原卡号查询&#10;成功时新增或覆盖本地学生缓存&#10;拒绝/故障不使用旧缓存放行&#10;日常查看和历史仅读本地缓存" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="500" height="245" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="一致性约束 · ORM 声明与事务&#10;活动 = ended_at 为空&#10;活动 student_id / device_id 各自唯一&#10;行锁内验证时间与区间不重叠&#10;无单独占用表，无历史更正/删除" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="500" width="500" height="245" as="geometry" />
        </mxCell>
        <mxCell id="device-rule" value="设备编辑与删除&#10;设置中增加 / 修改 / 删除&#10;有活动记录先结束，删除为软删除" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="500" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="card-many" value="成功写入缓存" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="325" y="427" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="device-rule-label" value="业务规则" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1500" y="427" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="card-hash" value="CardScanInput · 不是持久实体&#10;card: { issuer, uidHex } 仅短时内存&#10;main → HTTPS → API → provider&#10;查询完成/失败即释放原卡号&#10;不进学生档案 / 预览 / 日志 / 磁盘" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="845" width="500" height="210" as="geometry" />
        </mxCell>
        <mxCell id="tags" value="tags · 平面标签&#10;PK id / normalized_name UNIQUE&#10;display_name / archived_at / version&#10;不另存 deviceIds 数组" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="845" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="device-tags" value="device_tags · 唯一多对多关联&#10;PK (device_id, tag_id) + 两个 FK&#10;反向索引 (tag_id, device_id)&#10;设备 DTO 的 tagIds 由此投影" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="845" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="tag-many" value="N : 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="865" width="70" height="50" as="geometry" />
        </mxCell>
        <mxCell id="card-boundary" value="卡号仅作临时输入；以哈希关联学生" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="770" width="470" height="45" as="geometry" />
        </mxCell>
        <mxCell id="join-many" value="关联表 → 设备：N : 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1410" y="740" width="290" height="48" as="geometry" />
        </mxCell>
        <mxCell id="support-title" value="业务提交与可追踪性 · 逻辑关联使用对象 ID，业务更新与审计/操作结果同事务" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="1160" width="1650" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ops" value="operations&#10;clientId + requestId UNIQUE&#10;intent_id 唯一，预览成功消费一次&#10;路由 / payload 摘要 / 持久结果&#10;重登后仍可查原提交" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="85" y="1230" width="510" height="180" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="audit_events · 受限内部审计&#10;共享账号 / clientId / requestId / 时间&#10;必要时 student_id STRING(64) FK&#10;无原卡号，仅必要对象 ID 与字段名&#10;与资料/业务更新同事务；教师不可查" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="645" y="1230" width="510" height="180" as="geometry" />
        </mxCell>
        <mxCell id="logs" value="app_logs · 全部来源日志&#10;source + logId UNIQUE；提交后 ACK&#10;requestId / scanId / recordId 关联&#10;无原卡号 / studentId / 完整响应&#10;TBD-05：保留与产品外清理" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1205" y="1230" width="510" height="180" as="geometry" />
        </mxCell>
        <mxCell id="history" value="历史记录 · 只读内部库&#10;学生字段为最近一次成功刷卡刷新的数据库值&#10;查看历史不请求校园 API；取消登记不撤销资料刷新&#10;无编辑 / 删除 / 导出；软删除设备仍可显示历史&#10;TBD-01：字段；TBD-05：留存" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1520" width="800" height="230" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="NEXT-01 · 跨卡 / 换盐迁移延期&#10;换卡/盐/版本会改变 studentId 主键&#10;需要新旧映射，迁移历史 FK / 审计 / 持久结果&#10;新卡可单独缓存，但不自动合并旧历史&#10;固定盐哈希不防枚举/克隆，不是认证秘密" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1520" width="820" height="230" as="geometry" />
        </mxCell>
        <mxCell id="identity-protocol" value="身份协议与临时卡号生命周期&#10;studentId = 小写 hex(SHA-256(版本 / 固定盐 / 发行方 / UID 的有长度字节编码))&#10;客户端 / 服务端 / seed 共用协议；服务端由原卡号重算，不能让一个学生 ID 绑定另一张卡&#10;原卡号仅本次 HTTPS 查询；成功、失败、取消、超时均释放，不进入预览或离线重试" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1810" width="1680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="可分配 = 未软删除 + 未禁用 + 无活动记录；固定盐 hash 不等于不可枚举或不可克隆，不作为认证秘密。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2048" width="1720" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
