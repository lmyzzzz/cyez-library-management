        <mxCell id="title" value="02 · 数据模型、关系与一致性约束" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="实线从外键引用方指向被引用方，边旁写明基数；虚线为约束/算法说明。活动占用只从 usage_records 派生。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="students" value="students · 学生当前档案&#10;PK id: UUID / version / archived_at&#10;姓名、班级、校内学号：候选字段&#10;TBD-01：必填项与稳定人物键&#10;不存 is_using / 原 UID / 资料快照" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="500" height="245" as="geometry" />
        </mxCell>
        <mxCell id="records" value="usage_records · 一次使用一条&#10;PK id / FK student_id / FK device_id&#10;started_at / ended_at nullable&#10;notes / end_reason / version&#10;voided_at + reason / actor / timestamps" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="160" width="500" height="245" as="geometry" />
        </mxCell>
        <mxCell id="devices" value="devices · 可登记的设备资源&#10;PK id / FK room_id / unique code&#10;display_name / notes / version&#10;is_disabled / archived_at&#10;占用状态来自活动记录" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="160" width="500" height="245" as="geometry" />
        </mxCell>
        <mxCell id="student-many" value="N : 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="200" width="70" height="65" as="geometry" />
        </mxCell>
        <mxCell id="device-many" value="N : 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="200" width="70" height="65" as="geometry" />
        </mxCell>
        <mxCell id="card" value="student_credentials · 卡凭证别名&#10;PK id / FK student_id / issuer&#10;key_version / uid_hmac / revoked_at&#10;有效 issuer + keyVersion + hmac 唯一&#10;同卡轮换别名归属同一 studentId" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="500" height="245" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="一致性约束&#10;活动 = ended_at 空 且 voided_at 空&#10;活动 student_id / device_id 各自唯一&#10;ended_at ≥ started_at；FK 限制删除&#10;事务持对象锁检查有效时间区间不重叠" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
