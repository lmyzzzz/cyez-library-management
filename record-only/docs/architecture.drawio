        <mxCell id="device-controls" value="新增设备…    搜索 / 标签 / 状态筛选    刷新" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="840" width="760" height="70" as="geometry" />
