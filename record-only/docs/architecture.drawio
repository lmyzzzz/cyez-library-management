        </mxCell>
        <mxCell id="subtitle" value="上部为工作区组织与使用方→依赖；中部为上游→tarball 构建流；下部为本地 IPC。内部包使用 workspace:^。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="root" value="项目根 · 私有 monorepo · Yarn 4 精确版本 · 单一 yarn.lock · nodeLinker: node-modules&#10;workspaces 明确覆盖 record-only/apps/* + record-only/packages/*&#10;CI install --immutable；共享包 exports + 编译产物；禁止跨包相对导入与双份 DTO" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="1680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="server-app" value="record-only/apps/server · Fastify / Sequelize&#10;protocol + domain；共享账号、刷卡刷新、占用事务&#10;API 成功后新增/覆盖缓存；设备编辑 / 只读历史&#10;通过 ORM 操作 PostgreSQL，不手写 SQL" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="800" height="170" as="geometry" />
        </mxCell>
        <mxCell id="teacher-app" value="record-only/apps/teacher · Electron / React&#10;依赖 protocol + client-sdk + ui&#10;renderer：页面；preload：受限桥；main：子进程/网络&#10;main spawn apps/reader-mock；Cargo.lock 锁定原生依赖" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="390" width="800" height="170" as="geometry" />
        </mxCell>
        <mxCell id="packages-label" value="共享包&#10;workspace:^" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="685" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="domain" value="domain&#10;纯业务规则 / 时间 / 备注&#10;server 使用；无 I/O&#10;不混入后续三端 Session" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
