        <mxCell id="navigation" value="导航&#10;设备列表&#10;使用记录&#10;学生管理&#10;设备 / 标签&#10;账号与机房&#10;设置 / 诊断&#10;&#10;管理入口按角色显示" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="260" height="450" as="geometry" />
