        </mxCell>
        <mxCell id="rooms" value="rooms · 机房权限范围&#10;PK id / display_name / archived_at&#10;标签只作筛选，不授予机房权限" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
