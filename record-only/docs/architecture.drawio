        </mxCell>
        <mxCell id="shell-title" value="AppShell · 两个并列入口 · 共享业务账号，无管理员或机房权限" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
