        <mxCell id="support-title" value="业务提交与可追踪性 · 逻辑关联使用对象 ID，业务更新与审计/操作结果同事务" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="1160" width="1650" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ops" value="operations&#10;actorId + requestId UNIQUE&#10;intent_id 唯一，预览只能成功消费一次&#10;路由 / payload 摘要 / 持久结果&#10;重试先查结果再判断 preview" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="85" y="1230" width="510" height="180" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="audit_events · 追加写入&#10;eventId / actor / client / requestId&#10;对象 ID / batchId / 时间 / 原因&#10;字段名和必要变更元数据&#10;不保存完整旧学生资料" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="645" y="1230" width="510" height="180" as="geometry" />
        </mxCell>
        <mxCell id="logs" value="app_logs · 全部来源日志&#10;认证 source + logId UNIQUE&#10;level / 时间 / 关联 ID / 脱敏消息&#10;持久提交后 ACK&#10;TBD-05：保留期与查询权限" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1205" y="1230" width="510" height="180" as="geometry" />
        </mxCell>
        <mxCell id="history" value="已确定：历史展示当前资料&#10;usage_records 只保存 student_id&#10;修改班级/姓名后旧记录也展示新资料&#10;归档保留历史 FK；更正/作废需 admin + 原因&#10;TBD-01：上线前确认字段白名单" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1520" width="800" height="230" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="NEXT-01 · 明确延期：跨卡身份合并&#10;首版换卡视为另一位学生，不按姓名班级合并&#10;HMAC 是化名化，不能防克隆卡或代刷&#10;TBD-05：资料/记录/日志留存与导出规则&#10;JSON 用 Unix 毫秒整数；DB 用 timestamptz" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1520" width="820" height="230" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="可分配 = 未归档 + 未禁用 + 无活动记录。禁用与占用可并存；禁止维护第二套占用真值。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1848" width="1720" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
