          <mxGeometry x="1500" y="427" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="hmac" value="HMAC-SHA-256 · 服务端秘密键&#10;domain / issuer / length / UID 字节&#10;长度编码、字节序与前导零不能丢失&#10;key 不与业务库明文放在一起&#10;轮换保留旧键，重刷后加新别名" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
