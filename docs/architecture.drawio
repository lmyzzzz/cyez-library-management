        <mxCell id="title" value="故障处置" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1430" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Electron 执行业务与网络逻辑；Rust 仅凭本地进程、健康期限和保护状态机独立守护" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1430" height="36" as="geometry" />
        </mxCell>
        <mxCell id="network" value="Electron 网络心跳 · 每 1 秒&#10;服务端或当前控制教师失联 20 秒&#10;Electron 请求锁机；Rust 以&#10;Electron 提供的本地健康期限兜底" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="160" width="425" height="145" as="geometry" />
        </mxCell>
        <mxCell id="process" value="Rust 监督必需进程&#10;退出或身份校验失败&#10;检测后触发本地锁定流程" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="160" width="425" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ui-failure" value="Rust 监督 Electron 健康&#10;非预期退出 / 界面故障，或&#10;就绪后本地心跳 3 秒无响应&#10;启动就绪期单独计时" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fcebea;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="995" y="160" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="lock" value="Rust：LOCKING → 本地 IPC 要求锁定&#10;Electron：执行锁机（无 Session 也保持锁定）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9e1f6;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="275" y="425" width="650" height="95" as="geometry" />
        </mxCell>
        <mxCell id="lock-result" value="3 秒内是否收到 Electron 的实际锁定确认？" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9e1f6;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="275" y="595" width="650" height="85" as="geometry" />
        </mxCell>
        <mxCell id="pause" value="Rust：LOCKED，记录本地事实&#10;Electron：暂停 Session、持久化并上报事件&#10;无法联网时由 Electron 缓存补报" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ddf0e7;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="275" y="795" width="650" height="100" as="geometry" />
        </mxCell>
        <mxCell id="resume" value="连接和进程恢复，教师重新授权&#10;Electron 校验业务 → Rust 批准本地状态切换&#10;Electron 恢复界面与原 Session" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ddf0e7;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="275" y="1010" width="650" height="110" as="geometry" />
