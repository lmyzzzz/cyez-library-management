        <mxCell id="subtitle" value="Electron 应用内共享 TypeScript 业务；Rust 只接受有限本地动作，渲染器不能直接访问系统服务" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
