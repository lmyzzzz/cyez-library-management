        </mxCell>
        <mxCell id="subtitle" value="网络故障与本地进程故障分别检测；自动恢复连接不等于自动解锁" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
