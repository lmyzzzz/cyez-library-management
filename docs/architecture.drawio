        </mxCell>
        <mxCell id="network" value="网络监督 · 每 1 秒心跳&#10;服务端或当前控制教师&#10;连续 20 秒无有效回应" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="170" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="process" value="必需进程监督&#10;退出或身份校验失败&#10;检测后立即触发" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="505" y="170" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="ui-failure" value="Electron 防护故障&#10;非预期退出，或&#10;本地心跳连续 3 秒无响应" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fcebea;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="965" y="170" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="lock" value="立即请求锁定&#10;无活跃 Session 也必须保持锁定" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9e1f6;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="275" y="400" width="620" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lock-result" value="3 秒内是否确认锁定成功？" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e9e1f6;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="275" y="555" width="620" height="85" as="geometry" />
        </mxCell>
        <mxCell id="pause" value="锁机已确认 · Session 暂停&#10;记录原因与暂停起点，保留机器绑定" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ddf0e7;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="275" y="745" width="620" height="95" as="geometry" />
        </mxCell>
        <mxCell id="resume" value="连接与必需进程恢复，教师重新授权&#10;校验通过后恢复原 Session" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ddf0e7;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="275" y="930" width="620" height="95" as="geometry" />
        </mxCell>
        <mxCell id="shutdown" value="持久化防护故障&#10;请求系统关机" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fcebea;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
