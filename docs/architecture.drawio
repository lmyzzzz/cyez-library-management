        <mxCell id="msg-14" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1110.0" y="1710" as="sourcePoint" />
            <mxPoint x="270.0" y="1710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-15" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1110.0" y="1810" as="sourcePoint" />
            <mxPoint x="270.0" y="1810" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="title" value="03 · 入网、地址发现、教师接管与画面订阅" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="设备 ID 是身份；IP 是地址。学生主动建立控制与画面连接；只读教师的画面订阅不赋予控制权。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="teacher" value="教师 Electron" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="server" value="服务端 / 设备目录" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="490.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="student" value="学生 Electron" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="910.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="guardian" value="Rust 离线守护" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1330.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-0" value="1. 用户登录后启动应用&#10;等待首次锁定与 IPC 就绪" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1118.0" y="240" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-1" value="2. 设备凭证认证 + bootId&#10;上报版本，获取策略" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="340" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-2" value="3. 教师设备注册 / 报告端点&#10;业务操作另验账号权限" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="440" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-3" value="4. 查询控制教师&#10;机房 / deviceId / controlEpoch" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="540" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-4" value="5. 返回认证身份、地址&#10;端口、有效期与控制代次" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="640" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-5" value="6. 学生主动建立控制 WSS；画面需另行授权建连" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="740" width="824.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-6" value="7. 有效远端 ack → 本地健康报告&#10;不把网络职责交给 Rust" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1118.0" y="840" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-7" value="8. IP 变化：更新端点&#10;或其他教师请求接管" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="940" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-8" value="9. 下发新目录 / 新控制代次&#10;数据库变更不等于接管完成" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="1040" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-9" value="10. 验证新身份，建立新控制连接，拒绝旧代次命令" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="1140" width="824.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-10" value="11. 确认新代次与连接&#10;服务器才显示接管成功" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="1240" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-11" value="12. 独立流程：申请画面订阅&#10;控制教师或只读教师均需授权" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="1340" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-12" value="13. 返回短期订阅授权&#10;绑定设备 / 账号 / 范围 / 期限" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="1440" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-13" value="14. 下发订阅授权&#10;教师身份 / 端点 / 有效期" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="1540" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-14" value="15. 学生建立独立画面 WSS；校验身份与订阅，教师指定授权内参数" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="1640" width="824.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-15" value="16. 学生直接传画面；取消、撤销或到期停止，不经服务端中转" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="1740" width="824.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="首次入网须一次性注册码或审批；客户端自报 role=teacher 不会获得教师权限。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1925" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="地址重试、发现请求及接管过程不重置失联期限；任一必需连接 20 秒无有效回应即锁机。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1980" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="无控制教师或目录无效时保持锁定；跨机房需实际放通学生到服务器和教师的指定端口。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="2035" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="步骤 12–16 为独立订阅流程；只读教师画面连接不续期控制心跳。离线撤销以短期授权有效期兜底。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="2090" width="1680" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
