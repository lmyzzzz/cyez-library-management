          <mxGeometry x="490.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sqlite" value="各端 SQLite outbox" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="910.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="server" value="统一接收 / PostgreSQL" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1330.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="self-0" value="1. 全部日志本地持久化&#10;含诊断 / 错误 / 更新回滚" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="135.0" y="242" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-1" value="2. 应用全部日志先落盘&#10;main / renderer / worker / SDK" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="340" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-2" value="3. ReadLogs / 安装日志游标&#10;启动及运行中持续导入" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="440" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-3" value="4. logId / 来源实例 / 序号&#10;原始时间 / 级别 / 脱敏内容" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="540" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-4" value="5. 导入日志与游标同一事务&#10;保留原 ID，唯一约束去重" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="640" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-5" value="6. 本地持久提交成功" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="740" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-6" value="7. AckLogs / 确认日志段&#10;仅转交保管责任，可回收源副本" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="840" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-7" value="8. HTTPS 批传全部日志；业务事件附关联 logId，分别经 logs / events 接口" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="940" width="824.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="self-8" value="9. 并行归集自身/配套日志&#10;持久缓冲 → 内部接入" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1395.0" y="1042" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="self-9" value="10. 普通日志：去重落盘&#10;不驱动 Session 状态" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1395.0" y="1142" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="self-10" value="11. 业务事件：事务提交&#10;事件 + 日志 + 状态投影" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1395.0" y="1242" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-11" value="12. 提交后返回已持久化 ID 集合；部分失败不确认失败项" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="1340" width="824.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-12" value="13. 只回收最终确认的项&#10;未确认 / 隔离项继续保留" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="1440" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="self-13" value="14. 断网 / 重启后补传&#10;复用原 ID，退避重试" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="555.0" y="1542" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="self-14" value="15. 应用退出时继续留盘&#10;恢复后由 Electron 导入" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="135.0" y="1642" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="来源：两类 Electron 的主进程、renderer、worker、SDK、网络；Rust；初次安装、更新及回滚；服务器与配套服务。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1825" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="本地 ACK 只转移保管责任；服务端持久 ACK 才算完成。两级 ACK 丢失均可重放，不生成新的日志或业务事件。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1880" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="去重保留 logId / 来源 / bootId / 原始时间；业务 eventId 单独关联。服务端自身日志走内部归集，不需 HTTP 回环。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1935" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="不采样漏传，不清理未确认日志；无效项隔离告警，长记录分片。后台批传不阻塞心跳，日志接收不递归放大。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1990" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="存储故障禁止新使用并保护锁机；关机不等待网络。断电或磁盘损坏可能留下缺口，恢复后报告，不伪造日志。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="2045" width="1680" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
