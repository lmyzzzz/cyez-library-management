        <mxCell id="title" value="登记解锁时序" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1490" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Electron 负责业务校验、Session 和上报；Rust 只通过本地 IPC 审核保护状态并执行固定动作" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1490" height="36" as="geometry" />
        </mxCell>
        <mxCell id="teacher" value="教师端" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="135" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="server" value="服务端" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="425" y="135" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="student" value="学生 Electron" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="795" y="135" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="Rust 离线守护" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1165" y="135" width="300" height="65" as="geometry" />
        </mxCell>
        <mxCell id="message-label-0" value="1. 识别确认学生，登记并预留机器" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="188.0" y="209" width="354.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-1" value="2. 返回 Session、操作权与命令授权" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="188.0" y="304" width="354.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-2" value="3. 直连发送解锁命令（commandId / controlEpoch）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="188.0" y="399" width="724.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-3" value="5. 本地 IPC：请求解锁许可" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="928.0" y="589" width="379.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-4" value="6. 本地健康 / 保护代次检查&#10;进入 UNLOCK_PENDING，返回许可" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="928.0" y="684" width="379.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-5" value="8. 实际界面切换成功确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="928.0" y="874" width="379.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-6" value="9. 本地状态进入 UNLOCKED 并确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="928.0" y="969" width="379.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-7" value="10. Electron 持久化并直接上报&#10;UNLOCK_SUCCEEDED 业务事件" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="558.0" y="1074" width="354.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-8" value="11. 返回同一命令的执行回执" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="188.0" y="1179" width="724.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-9" value="12. 更新 Session，提供已确认状态" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="188.0" y="1284" width="354.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="4. Electron 校验授权、控制代次和网络&#10;复用 TS 规则，持久化命令意图" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0eafa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="495" width="410" height="85" as="geometry" />
        </mxCell>
        <mxCell id="render-unlock" value="7. Electron 主进程切换渲染界面&#10;等待实际 UI 状态确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0eafa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="780" width="410" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sequence-note" value="Rust 不连接教师或服务端，不处理学生档案、业务 Session 与网络授权。&#10;解锁超时保留机器预留；故障恢复需要教师重新授权，旧本地确认不能覆盖新锁定要求。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="1410" width="1440" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
