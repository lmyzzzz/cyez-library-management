        <mxCell id="footer" value="突然断电 / 长按电源可能无任何上报：先标原因待确认，保留最后确认时间与可能结束区间。&#10;管理员若同时停止服务与界面，本地故障动作无法得到保证。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1325" width="1720" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
