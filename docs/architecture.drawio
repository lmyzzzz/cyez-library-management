        </mxCell>
        <mxCell id="message-label-1" value="2. 返回 Session、操作权与命令授权" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="208.0" y="324" width="344.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-2" value="3. 直连发送解锁命令（commandId / controlEpoch）" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="208.0" y="424" width="704.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-3" value="4. 校验健康与授权，持久化意图&#10;通过本地 IPC 执行解锁" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="928.0" y="534" width="329.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-4" value="5. 确认界面实际切换成功" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="928.0" y="644" width="329.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-5" value="6. 持久化并直接上报&#10;UNLOCK_SUCCEEDED 事件" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="568.0" y="754" width="344.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-6" value="7. 返回同一命令的执行回执" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="208.0" y="854" width="704.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="message-label-7" value="8. 更新 Session，提供已确认状态" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="208.0" y="954" width="344.0" height="57" as="geometry" />
        </mxCell>
        <mxCell id="sequence-note" value="解锁超时：保留预留并查询学生实际状态；不可直接假定失败后释放机器。&#10;失联、进程退出或授权失效：拒绝解锁；恢复使用需要教师再次授权。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="1080" width="1340" height="65" as="geometry" />
        </mxCell>
