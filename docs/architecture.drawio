        <mxCell id="title" value="10 · 现代 Yarn workspaces 与复用边界" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Node.js 服务端与 Electron 使用 TypeScript；同一代码库不代表同一权限，Rust 仅共享本地协议。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="root" value="私有 monorepo 根：packageManager 固定 Yarn 4 精确版本 · 单一 yarn.lock&#10;workspaces: apps/* + packages/* · nodeLinker: node-modules · CI: yarn install --immutable" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="1680" height="105" as="geometry" />
        </mxCell>
        <mxCell id="server" value="apps/server · @cyez/server&#10;protocol + domain&#10;服务端最终鉴权 / 占用事务" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="teacher" value="apps/teacher · @cyez/teacher&#10;protocol + domain + client-sdk + ui&#10;教师权限 / 直连操作 / 订阅" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="350" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="student" value="apps/student · @cyez/student&#10;protocol + domain + client-sdk&#10;+ guardian-contract + ui" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="350" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="shared-title" value="共享工作区 · 内部显式依赖 workspace:^ · 通过 exports 访问编译产物" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="610" width="1650" height="45" as="geometry" />
        </mxCell>
        <mxCell id="protocol" value="@cyez/protocol&#10;网络 / 日志 / 事件 DTO 与 schema&#10;不含设备私钥或服务端数据库" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="95" y="690" width="490" height="115" as="geometry" />
        </mxCell>
        <mxCell id="domain" value="@cyez/domain&#10;Session 纯规则 / 状态转换&#10;不依赖 Electron、数据库或 I/O" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="655" y="690" width="490" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sdk" value="@cyez/client-sdk&#10;依赖 protocol：认证 / 重连&#10;全部日志批传 / 确认 / 重试" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1215" y="690" width="490" height="115" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="@cyez/guardian-contract&#10;本地 IPC schema / ReadLogs、AckLogs / 序列化测试向量" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="95" y="850" width="770" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="@cyez/ui&#10;组件库适配 / 共享界面；不包含系统权限或服务端逻辑" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="935" y="850" width="770" height="100" as="geometry" />
        </mxCell>
        <mxCell id="server-imports-label" value="工作区依赖" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="170" y="520" width="300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="teacher-imports-label" value="工作区依赖" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="750" y="520" width="300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="student-imports-label" value="工作区依赖" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="520" width="300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="cargo" value="native/guardian · Cargo / Rust&#10;仅从 guardian-contract 生成或校验 IPC 类型&#10;不导入 domain、client-sdk 或任何网络业务包" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fcebea;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="95" y="1110" width="770" height="120" as="geometry" />
        </mxCell>
        <mxCell id="schema-native-label" value="schema / fixtures，不执行 TypeScript" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="1007.0" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="build" value="构建与交付&#10;共享包按拓扑构建 → 应用 → 安装包&#10;Cargo 独立编译 → 装配守护二进制" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="935" y="1110" width="770" height="120" as="geometry" />
        </mxCell>
        <mxCell id="build-rules" value="禁止：跨包相对目录导入、复制 DTO、服务端依赖 UI、Rust 重写业务状态机。&#10;依赖声明与 exports 作为边界；Electron 原生模块按目标 ABI 重建，不能混用服务器编译产物。&#10;全量工作区脚本排除根包，防止递归；Cargo 不冒充 Yarn workspace。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="95" y="1290" width="1610" height="115" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="本页规定编码阶段目录与依赖关系；当前仓库交付文档与图，不代表应用骨架或运行时已经实现。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1455" width="1720" height="70" as="geometry" />
        </mxCell>
      </root>
