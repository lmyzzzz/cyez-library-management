          <mxGeometry x="730.0" y="769.5" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="uncertain" value="超时不等于执行失败&#10;预留与暂停都算占用&#10;迟到事件按 Session / bootId 归属&#10;不得污染新 Session&#10;恢复实际使用须重新授权" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="815" width="440" height="220" as="geometry" />
        </mxCell>
        <mxCell id="timing" value="登记总时长：登记 → 最终结束&#10;可用时长：已确认解锁区间之和&#10;暂停区间排除&#10;UTC 用于展示 / 单调时钟计时&#10;未知结束点保留区间而非伪造" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1290" y="815" width="440" height="220" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="一个学生 / 一台设备最多对应一个未结束的使用 Session；预留、暂停和结束待确认均占用。&#10;网络失联先标连接与证据状态，锁机事件才确认暂停；故障恢复不自动解锁，人工更正追加审计。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1225" width="1720" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
