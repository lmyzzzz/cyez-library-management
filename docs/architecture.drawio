        </mxCell>
        <mxCell id="title" value="09 · 更新下载、受控维护与回滚" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Electron 负责版本决策与联网；独立受限执行器完成注销后的切换，Rust 仅配合本地维护状态。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="server" value="版本服务 / 包仓库" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="electron" value="Electron 更新协调" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="490.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="installer" value="本地更新执行器" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="910.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="Rust 离线守护" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1330.0" y="145" width="400.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-0" value="1. 启动检查签名清单&#10;网络 / IPC / OS 兼容要求" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="240" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-1" value="2. 返回清单与下载地址&#10;签名与摘要不等价" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="340" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="self-2" value="3. 下载暂存包并验证&#10;安装条件未满足则等待" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="555.0" y="442" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-3" value="4. 提交受控更新计划&#10;包 / 目标版本 / 维护期限" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="540" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="self-4" value="5. 再校验暂存包与计划&#10;固定动作，不接受任意 shell" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="975.0" y="642" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-5" value="6. 进入 MAINTENANCE&#10;限定对象、期限、关联计划" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1118.0" y="740" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-6" value="7. 确认进入维护&#10;豁免仅覆盖预期退出" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1118.0" y="840" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="self-7" value="8. 确认无 Session 且已注销&#10;停止组件 / 原子切换版本" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="975.0" y="942" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-8" value="9. 重启守护 / 退出维护&#10;等待用户应用健康验证" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1118.0" y="1040" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-9" value="10. 用户会话启动应用&#10;默认锁定，重新握手" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="1140" width="824.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-10" value="11. 返回版本与本地健康结果&#10;与服务器可达性分别判断" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="1240" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-11" value="12. 按来源 / 游标导入全部日志&#10;诊断、失败、回滚也进入 outbox" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="698.0" y="1340" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-12" value="13. 上传全部更新日志与结果&#10;无网络时保持锁定并待补传" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="1440" width="404.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="本地健康失败或超时：执行器回滚至已验证版本并重新默认锁定；无用户时等待验证，不伪造成功。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1625" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="安装日志独立于版本目录；停电据计划恢复。身份、全部日志 outbox、未交接的守护/安装日志全部保留。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1680" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="初次安装尚未入网或应用无法启动：日志继续留盘，恢复后导入补传；不能只上报最终更新结果。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1735" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="教师端安装前先结束或转交控制任务；签名私钥不部署到客户端，Rust 从不下载或选择更新版本。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1790" width="1680" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
