          <mxGeometry x="1255" y="340" width="470" height="45" as="geometry" />
        </mxCell>
        <mxCell id="network" value="连接与身份模块&#10;注册 / 发现 / TLS / SDK&#10;网络心跳与两路失联计时" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="425" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="business" value="命令与 Session 模块&#10;签名 / 幂等 / 控制代次&#10;共享 domain 规则与业务投影" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="425" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="remote-network-label" value="只有 Electron 访问网络" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="155" y="264" width="370" height="48" as="geometry" />
        </mxCell>
        <mxCell id="coordinator" value="应用协调器：请求保护动作、确认界面状态、汇总守护进程状态与事件；故障优先" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f8;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="620" width="1020" height="85" as="geometry" />
        </mxCell>
        <mxCell id="render" value="渲染器 + preload&#10;多屏锁机 / 实际确认&#10;响应健康挑战" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="805" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="workers" value="应用内 worker&#10;全部日志归集 / 批传&#10;截图 / 更新校验" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="805" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="database" value="SQLite 单写者&#10;全部日志 / 事件 outbox&#10;命令与恢复状态" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="805" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="health" value="本地健康报告：主逻辑 + 锁机渲染器都要响应&#10;两路远端 ack 才可更新网络健康期限；普通 IPC 心跳不可续期" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="1020" width="1020" height="100" as="geometry" />
        </mxCell>
        <mxCell id="app-boundary" value="不向 renderer 暴露私钥、业务数据库或守护管道&#10;画面与更新任务不得阻塞主业务 / 锁机确认；有界队列丢弃过时帧&#10;Electron 持有远端授权，Rust 不重新实现业务鉴权" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="1210" width="1020" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pipe" value="受限命名管道&#10;绑定子进程 / 用户会话&#10;IPC 版本 / 请求序号 / 保护代次" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1280" y="425" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="machine" value="本地保护状态机&#10;STARTING / LOCKED / UNLOCKED&#10;LOCKING / MAINTENANCE 等" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1280" y="620" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="supervisor" value="监督与定时器&#10;进程句柄 / 必需进程实例&#10;本地健康截止时间" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1280" y="815" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="journal" value="全部守护日志：状态 / 事件 / 诊断&#10;ReadLogs → Electron 持久导入&#10;AckLogs 后转交上传责任" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f2eb;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1010" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="actions" value="固定系统动作&#10;启动应用 / 请求锁定 / 关机&#10;配合受控维护" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1210" width="420" height="115" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Rust 不创建 HTTP/WSS 连接、不监听远端、不处理人脸/Session/截图、不下载更新。&#10;本地报告可被管理员篡改，因此其健康期限不能作为远端连接真实性的强证明。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1415" width="1720" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
