          <mxGeometry x="1145" y="1070" width="130" height="45" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="转换规则：故障锁定优先于解锁确认；每次保护故障 / 守护重启 / 新用户会话都使旧许可失效。&#10;请求关机是固定本地动作，可由已校验的 Electron 请求或守护故障触发；不代表系统已经断电。&#10;无交互式用户时保持待机，不启动 30 秒就绪期限；正常系统关机中的预期退出不重复触发故障。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="1260" width="1620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Rust 仅信任受约束的本地应用报告，不验证远端身份；普通心跳不得续期网络健康期限。&#10;同一动作使用请求 ID 去重，晚到结果不能覆盖较新的保护代次。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1435" width="1720" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
