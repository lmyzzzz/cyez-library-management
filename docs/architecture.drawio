        </mxCell>
        <mxCell id="remote" value="远端：服务端 HTTPS / WSS + 当前控制教师 WSS + 独立画面通道" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
