        <mxCell id="title" value="04 · 登记、授权与实际解锁时序" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1750" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="业务授权归 Electron；本地保护许可归 Rust；服务端依据学生持久化事件确认使用开始。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="68" width="1750" height="36" as="geometry" />
        </mxCell>
        <mxCell id="teacher" value="教师 Electron" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="145" width="316.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="server" value="服务端 / 数据库" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="406.0" y="145" width="316.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="student" value="学生 Electron 主逻辑" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="742.0" y="145" width="316.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="guardian" value="Rust 离线状态机" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1078.0" y="145" width="316.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="renderer" value="锁机渲染器" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1414.0" y="145" width="316.0" height="80" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-0" value="1. 首次 UID + 人工资料&#10;或日常人脸确认学生" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="236.0" y="240" width="320.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-1" value="2. 登记并预留机器&#10;事务检查学生 / 机器占用" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="236.0" y="340" width="320.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-2" value="3. 返回 Session / 命令授权&#10;commandId / controlEpoch" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="236.0" y="440" width="320.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-3" value="4. 经直连发送授权命令；重试使用同一 commandId" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="236.0" y="540" width="656.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="self-4" value="5. 鉴权 / 去重 / 健康检查&#10;持久化命令意图" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="765.0" y="642" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-5" value="6. RequestUnlock&#10;请求 ID / 本地保护代次" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="908.0" y="740" width="320.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-6" value="7. 本地健康通过，发一次许可&#10;进入 UNLOCK_PENDING" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="908.0" y="840" width="320.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-7" value="8. 切换界面：隐藏锁机窗口，应用继续运行" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="908.0" y="940" width="656.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-8" value="9. 返回实际界面切换结果；不是仅确认收到消息" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="908.0" y="1040" width="656.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-9" value="10. ConfirmUnlocked&#10;匹配请求 / 保护代次" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="908.0" y="1140" width="320.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-10" value="11. 原子确认 UNLOCKED&#10;新故障优先于旧确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="908.0" y="1240" width="320.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="self-11" value="12. SQLite 事务落盘&#10;UNLOCK_SUCCEEDED" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="765.0" y="1342" width="270" height="58" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-12" value="13. 直接批量上报学生事件&#10;服务端事务更新 Session" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="572.0" y="1440" width="320.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-13" value="14. 持久化后确认 eventId&#10;应用再回收发送队列" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="572.0" y="1540" width="320.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="msg-text-14" value="15. 回执关联原命令；教师从服务端获取最终业务状态" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="236.0" y="1640" width="656.0" height="62" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="仅收到 Rust 许可不算解锁成功；实际界面与本地状态均确认后，才生成使用开始事件。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1825" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="超时或回执丢失：保留机器预留并查询同一命令，不直接当成失败后释放机器。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1880" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="任何阶段故障锁定都会递增本地保护代次，旧许可或迟到确认不得重新放行。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4dc;strokeColor=none;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1935" width="1680" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
